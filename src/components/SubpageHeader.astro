---
interface Props {
  activePage?: "about" | "contact" | "privacy" | "terms" | "";
}
const { activePage = "" } = Astro.props;
---
<!-- Header Navigation -->
<header class="w-full max-w-4xl mx-auto px-6 py-6 flex items-center justify-between z-10 relative">
  <a
    href="/"
    class="flex items-center space-x-2 text-ink font-semibold tracking-tight text-sm hover:opacity-80 transition-opacity"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><circle cx="12" cy="12" r="10"></circle><polyline
        points="12 6 12 12 16 14"></polyline></svg
    >
    <span>Zen Aesthetic Clock</span>
  </a>
  <nav class="flex items-center space-x-4">
    <a
      href="/about/"
      data-astro-prefetch
      class={`text-sm transition-colors ${activePage === "about" ? "text-ink font-bold" : "text-body hover:text-ink font-semibold"}`}
      >About</a
    >
    <a
      href="/contact/"
      data-astro-prefetch
      class={`text-sm transition-colors ${activePage === "contact" ? "text-ink font-bold" : "text-body hover:text-ink font-semibold"}`}
      >Contact</a
    >

    <a
      href="/privacy/"
      data-astro-prefetch
      class={`text-sm transition-colors ${activePage === "privacy" ? "text-ink font-bold" : "text-body hover:text-ink font-semibold"}`}
      >Privacy</a
    >
    <a
      href="/terms/"
      data-astro-prefetch
      class={`text-sm transition-colors ${activePage === "terms" ? "text-ink font-bold" : "text-body hover:text-ink font-semibold"}`}
      >Terms</a
    >
  </nav>
</header>
