---
interface Props {
  type: 'leaderboard' | 'skyscraper-left' | 'skyscraper-right';
  adSlot?: string;
  adClient?: string;
}

const { 
  type,
  adSlot = '',
  adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT || 'ca-pub-XXXXXXXXXXXXXXXX'
} = Astro.props;

// Determine if we should show real AdSense or Dummy Ad
const showRealAdSense = import.meta.env.PUBLIC_ENABLE_ADSENSE === 'true' && adSlot;

// Classes matching type
let positionClasses = '';
let sizeClasses = '';
let zenTransitionClasses = '';

if (type === 'leaderboard') {
  positionClasses = 'top-4 left-1/2 -translate-x-1/2';
  sizeClasses = 'w-[320px] h-[50px] md:w-[728px] md:h-[90px]';
  zenTransitionClasses = 'group-data-[zen=true]/zen:-translate-y-4';
} else if (type === 'skyscraper-left') {
  positionClasses = 'left-4 top-1/2 -translate-y-1/2';
  sizeClasses = 'w-[160px] h-[600px] hidden lg:flex';
  zenTransitionClasses = 'group-data-[zen=true]/zen:-translate-x-4';
} else if (type === 'skyscraper-right') {
  positionClasses = 'right-4 top-1/2 -translate-y-1/2';
  sizeClasses = 'w-[160px] h-[600px] hidden lg:flex';
  zenTransitionClasses = 'group-data-[zen=true]/zen:translate-x-4';
}
---

<div 
  class={`ad-slot absolute ${positionClasses} ${sizeClasses} bg-canvas-soft/30 backdrop-blur-sm rounded transition-all duration-1000 group-data-[zen=true]/zen:opacity-0 group-data-[zen=true]/zen:pointer-events-none ${zenTransitionClasses} z-0 overflow-hidden shadow-sm border border-hairline`}
  data-ad-type={type}
>
  {showRealAdSense ? (
    <div class="w-full h-full flex items-center justify-center bg-canvas">
      <ins class="adsbygoogle"
           style="display:block;width:100%;height:100%;"
           data-ad-client={adClient}
           data-ad-slot={adSlot}
           data-ad-format={type === 'leaderboard' ? 'horizontal' : 'vertical'}
           data-full-width-responsive="true"></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </div>
  ) : (
    /* Dummy Ad Content */
    type === 'leaderboard' ? (
      <div class="relative w-full h-full bg-canvas text-ink flex items-center p-1 md:p-2">
        <div class="absolute top-0 right-0 bg-canvas-soft border-b border-l border-hairline text-[8px] px-1 text-mute flex items-center space-x-1 rounded-bl z-10">
          <span>Ad</span><span class="cursor-pointer hover:text-ink">ⓘ</span><span class="cursor-pointer hover:text-ink">×</span>
        </div>
        <div class="hidden md:flex w-12 h-12 bg-canvas-soft items-center justify-center rounded">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
        </div>
        <div class="ml-2 md:ml-4 flex-1 overflow-hidden flex flex-col justify-center">
          <div class="text-xs md:text-sm font-semibold truncate text-ink">Upgrade Your Workspace Setup</div>
          <div class="text-[10px] md:text-xs text-mute truncate">Discover premium, minimalist desk accessories engineered for focus.</div>
        </div>
        <button class="ml-2 md:ml-4 bg-[#4285F4] text-white text-[10px] md:text-xs px-3 py-1.5 md:px-4 md:py-2 rounded shadow-sm hover:bg-[#3367D6] transition-colors whitespace-nowrap">Shop Now</button>
      </div>
    ) : type === 'skyscraper-left' ? (
      <div class="relative w-full h-full bg-canvas text-ink flex flex-col p-3">
        <div class="absolute top-0 right-0 bg-canvas-soft border-b border-l border-hairline text-[8px] px-1 text-mute flex items-center space-x-1 rounded-bl z-10">
          <span>Ad</span><span class="cursor-pointer hover:text-ink">ⓘ</span><span class="cursor-pointer hover:text-ink">×</span>
        </div>
        <div class="w-full h-[140px] bg-canvas-soft flex-shrink-0 flex items-center justify-center rounded mt-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path></svg>
        </div>
        <div class="mt-4 flex flex-col">
          <div class="text-sm font-semibold text-ink leading-tight">Mechanical Keyboards</div>
          <div class="text-xs text-mute mt-2 leading-relaxed">Experience the ultimate typing feel. Perfect for long coding sessions.</div>
        </div>
        <div class="mt-auto mb-2">
          <button class="w-full bg-[#4285F4] text-white text-xs py-2 rounded shadow-sm hover:bg-[#3367D6] transition-colors">Learn More</button>
        </div>
      </div>
    ) : (
      <div class="relative w-full h-full bg-canvas text-ink flex flex-col p-3">
        <div class="absolute top-0 right-0 bg-canvas-soft border-b border-l border-hairline text-[8px] px-1 text-mute flex items-center space-x-1 rounded-bl z-10">
          <span>Ad</span><span class="cursor-pointer hover:text-ink">ⓘ</span><span class="cursor-pointer hover:text-ink">×</span>
        </div>
        <div class="w-full h-[140px] bg-canvas-soft flex-shrink-0 flex items-center justify-center rounded mt-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-mute"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="mt-4 flex flex-col">
          <div class="text-sm font-semibold text-ink leading-tight">Master Web Dev</div>
          <div class="text-xs text-mute mt-2 leading-relaxed">Join 10,000+ students learning advanced Astro and Tailwind CSS.</div>
        </div>
        <div class="mt-auto mb-2">
          <button class="w-full bg-[#4285F4] text-white text-xs py-2 rounded shadow-sm hover:bg-[#3367D6] transition-colors">Start Free Trial</button>
        </div>
      </div>
    )
  )}
</div>
