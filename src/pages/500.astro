---
import Layout from "../layouts/Layout.astro";
import BackgroundBlobs from "../components/BackgroundBlobs.astro";
---

<Layout title="500 Internal Server Error — Zen Aesthetic Clock">
  <BackgroundBlobs />

  <!-- Main Content Area -->
  <main
    class="flex-1 w-full h-screen flex flex-col items-center justify-center px-6 relative z-10"
  >
    <!-- Glassmorphic Content Card -->
    <article
      class="bg-canvas-soft/80 backdrop-blur-md border border-hairline rounded-lg p-10 md:p-14 shadow-lg text-center max-w-[448px] w-full flex flex-col items-center"
    >
      <div class="text-mute/80 mb-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-mute"
          ><path
            d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
          ></path><line x1="12" y1="9" x2="12" y2="13"></line><line
            x1="12"
            y1="17"
            x2="12.01"
            y2="17"></line></svg
        >
      </div>
      <h1 class="text-6xl font-bold tracking-tight text-ink mb-4">500</h1>
      <p class="text-sm font-semibold text-ink mb-2">Internal Server Error</p>
      <p class="text-xs text-mute leading-relaxed mb-8">
        Something went wrong on our end. We are looking into the issue. Please
        try again shortly.
      </p>

      <!-- Back Home Button -->
      <a
        href="/"
        class="w-full bg-canvas-soft hover:bg-hairline text-ink border border-hairline text-xs font-semibold py-3 rounded-full shadow-sm transition-all duration-300 hover:shadow-md hover:border-hairline-strong flex items-center justify-center space-x-2 group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transform group-hover:-translate-x-0.5 transition-transform"
          ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
            points="12 19 5 12 12 5"></polyline></svg
        >
        <span>Back to Clock</span>
      </a>
    </article>
  </main>


</Layout>
