---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 Page Not Found — Zen Aesthetic Clock">
  <!-- Dynamic Blobs Background -->
  <div
    class="fixed inset-0 z-[-2] bg-canvas overflow-hidden flex items-center justify-center transition-colors duration-1000"
    id="bg-container"
  >
    <div
      class="absolute w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] bg-[#00ffff] opacity-30 dark:opacity-20 rounded-full blur-[100px] animate-blob-1"
      id="blob1"
    >
    </div>
    <div
      class="absolute w-[50vw] h-[50vw] max-w-[700px] max-h-[700px] bg-[#ff00ff] opacity-30 dark:opacity-20 rounded-full blur-[100px] animate-blob-2"
      id="blob2"
    >
    </div>
    <div
      class="absolute w-[55vw] h-[55vw] max-w-[750px] max-h-[750px] bg-[#ffff00] opacity-30 dark:opacity-20 rounded-full blur-[100px] animate-blob-3"
      id="blob3"
    >
    </div>
  </div>

  <!-- Main Content Area -->
  <main
    class="flex-1 w-full h-screen flex flex-col items-center justify-center px-6 relative z-10"
  >
    <!-- Glassmorphic Content Card -->
    <article
      class="bg-canvas-soft/80 backdrop-blur-md border border-hairline rounded-lg p-10 md:p-14 shadow-lg text-center max-w-[448px] w-full flex flex-col items-center"
    >
      <div class="text-mute/80 mb-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="48"
          height="48"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-mute"
          ><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"
          ></path><path d="m9 9 6 6"></path></svg
        >
      </div>
      <h1 class="text-6xl font-bold tracking-tight text-ink mb-4">404</h1>
      <p class="text-sm font-semibold text-ink mb-2">Page Not Found</p>
      <p class="text-xs text-mute leading-relaxed mb-8">
        The time or page you are looking for does not exist. It may have drifted
        away or been removed.
      </p>

      <!-- Back Home Button -->
      <a
        href="/"
        class="w-full bg-canvas-soft hover:bg-hairline text-ink border border-hairline text-xs font-semibold py-3 rounded-full shadow-sm transition-all duration-300 hover:shadow-md hover:border-hairline-strong flex items-center justify-center space-x-2 group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transform group-hover:-translate-x-0.5 transition-transform"
          ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
            points="12 19 5 12 12 5"></polyline></svg
        >
        <span>Back to Clock</span>
      </a>
    </article>
  </main>

  <script>
    // Randomize background blob starting positions on load
    const blobs = [
      document.getElementById("blob1"),
      document.getElementById("blob2"),
      document.getElementById("blob3"),
    ];
    const animationDurations = [25, 30, 35];
    blobs.forEach((blob, index) => {
      if (blob) {
        const duration = animationDurations[index];
        const randomDelay = Math.random() * -duration;
        blob.style.animationDelay = `${randomDelay}s`;
      }
    });
  </script>
</Layout>
