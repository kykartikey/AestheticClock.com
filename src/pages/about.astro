---
import Layout from "../layouts/Layout.astro";
import BackgroundBlobs from "../components/BackgroundBlobs.astro";
import SubpageHeader from "../components/SubpageHeader.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="About Us — Zen Aesthetic Clock">
  <BackgroundBlobs />
  <SubpageHeader activePage="about" />

  <!-- Main Content Area -->
  <main class="flex-1 w-full max-w-4xl mx-auto px-6 md:px-0 py-12 z-10 relative">
    <!-- Back Button -->
    <a
      href="/"
      class="inline-flex items-center space-x-2 text-xs text-mute hover:text-ink transition-colors mb-8 group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transform group-hover:-translate-x-0.5 transition-transform"
        ><line x1="19" y1="12" x2="5" y2="12"></line><polyline
          points="12 19 5 12 12 5"></polyline></svg
      >
      <span>Back to Clock</span>
    </a>

    <!-- Glassmorphic Content Card -->
    <article
      class="bg-canvas-soft/60 backdrop-blur-md border border-hairline rounded-lg p-8 md:p-12 shadow-lg select-text"
    >
      <h1 class="text-3xl font-bold text-ink tracking-tight mb-8">About Us</h1>

      <div
        class="prose prose-sm dark:prose-invert max-w-none space-y-6 text-sm text-body leading-relaxed"
      >
        <p class="text-base font-medium text-ink">
          Zen Aesthetic Clock was born out of a simple idea: that utility tools
          can be beautiful, and focus tools should feel calm.
        </p>
        <p>
          In a world dominated by hyper-stimulating websites and distracting
          alerts, finding the right zone for deep work is incredibly difficult.
          Many clocks and focus timers are cluttered, poorly designed, or
          covered in intrusive pop-ups. We wanted to design the exact opposite—a
          digital companion that flows into the background of your workspace,
          enhances your desk aesthetic, and supports your concentration.
        </p>

        <h2 class="text-lg font-semibold text-ink mt-8">Our Core Principles</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4">
          <div class="bg-canvas p-4 rounded border border-hairline shadow-sm">
            <h3 class="font-semibold text-ink text-sm mb-2">
              Visual Quietness
            </h3>
            <p class="text-xs text-mute leading-relaxed">
              We practice extreme minimalism. No clutter, no pop-up alerts, and
              soft dynamic backgrounds that relax the eyes.
            </p>
          </div>
          <div class="bg-canvas p-4 rounded border border-hairline shadow-sm">
            <h3 class="font-semibold text-ink text-sm mb-2">Premium Utility</h3>
            <p class="text-xs text-mute leading-relaxed">
              High-fidelity typography, customizable time configurations, and
              responsive designs that scale across desktops, iPads, and mobile
              screens.
            </p>
          </div>
          <div class="bg-canvas p-4 rounded border border-hairline shadow-sm">
            <h3 class="font-semibold text-ink text-sm mb-2">User Ownership</h3>
            <p class="text-xs text-mute leading-relaxed">
              All settings, layouts, and custom playlist keys are saved entirely
              in your local browser. We never track or upload your preferences.
            </p>
          </div>
        </div>

        <h2 class="text-lg font-semibold text-ink mt-8">Core Features</h2>
        <ul class="list-disc list-inside space-y-2 ml-4">
          <li>
            <strong>Digital Clock & Custom Pomodoro:</strong> Toggle between a sleek
            timekeeper with seconds and an custom focus interval countdown.
          </li>
          <li>
            <strong>YouTube Music Player:</strong> Paste any YouTube video or livestream
            link to play background ambient focus tracks without leaving the site.
            The application automatically remembers your last-entered video link so
            it instantly reloads on your next visit.
          </li>
          <li>
            <strong>Cinematic Zen Mode:</strong> Double-tap to clear the screen, scale
            up the clock display, and dim the background, turning your display into
            a gorgeous desk screensaver.
          </li>
          <li>
            <strong>Hybrid Ads Model:</strong> Ad revenue keeps the clock online and
            free to use, but entering Zen Mode instantly unmounts ads to ensure zero
            distractions during study blocks.
          </li>
        </ul>

        <h2 class="text-lg font-semibold text-ink mt-8">The Team</h2>
        <p>
          We are a small team of independent designers and developers passionate
          about productivity and interface aesthetics. We built this app to
          solve our own desk setups and are excited to share it with developers,
          students, writers, and digital workers around the world.
        </p>
      </div>
    </article>
  </main>

  <!-- Footer Navigation -->
  <Footer />
</Layout>
