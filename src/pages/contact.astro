---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us — Zen Aesthetic Clock">
  <!-- Dynamic Blobs Background -->
  <div class="fixed inset-0 z-[-2] bg-canvas overflow-hidden flex items-center justify-center transition-colors duration-1000" id="bg-container">
    <div class="absolute w-[60vw] h-[60vw] max-w-[800px] max-h-[800px] bg-[#00ffff] opacity-30 dark:opacity-20 rounded-full blur-[100px] animate-blob-1" id="blob1"></div>
    <div class="absolute w-[50vw] h-[50vw] max-w-[700px] max-h-[700px] bg-[#ff00ff] opacity-30 dark:opacity-20 rounded-full blur-[100px] animate-blob-2" id="blob2"></div>
    <div class="absolute w-[55vw] h-[55vw] max-w-[750px] max-h-[750px] bg-[#ffff00] opacity-30 dark:opacity-20 rounded-full blur-[100px] animate-blob-3" id="blob3"></div>
  </div>

  <!-- Header Navigation -->
  <header class="w-full max-w-4xl mx-auto px-6 py-6 flex items-center justify-between z-10 relative">
    <a href="/" class="flex items-center space-x-2 text-ink font-semibold tracking-tight text-sm hover:opacity-80 transition-opacity">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      <span>Zen Aesthetic Clock</span>
    </a>
    <nav class="flex items-center space-x-4">
      <a href="/about" class="text-sm text-body hover:text-ink font-semibold transition-colors">About</a>
      <a href="/contact" class="text-sm text-ink font-bold transition-colors">Contact</a>
      <a href="/privacy" class="text-sm text-body hover:text-ink font-semibold transition-colors">Privacy</a>
      <a href="/terms" class="text-sm text-body hover:text-ink font-semibold transition-colors">Terms</a>
    </nav>
  </header>

  <!-- Main Content Area -->
  <main class="flex-1 w-full max-w-4xl mx-auto px-6 py-12 z-10 relative">
    <!-- Back Button -->
    <a href="/" class="inline-flex items-center space-x-2 text-xs text-mute hover:text-ink transition-colors mb-8 group">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:-translate-x-0.5 transition-transform"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
      <span>Back to Clock</span>
    </a>

    <!-- Glassmorphic Content Card -->
    <article class="bg-canvas-soft/80 backdrop-blur-md border border-hairline rounded-lg p-8 md:p-12 shadow-lg select-text">
      <h1 class="text-3xl font-bold text-ink tracking-tight mb-4">Contact Us</h1>
      <p class="text-sm text-body leading-relaxed mb-8">
        Have questions, feedback, or custom lofi playlist suggestions? We would love to hear from you. Drop us a message below or write to us directly at <a href="mailto:support@aestheticclock.com" class="text-link hover:underline font-medium">support@aestheticclock.com</a>.
      </p>
      
      <div id="contact-success" class="hidden bg-[#0070f3]/10 border border-[#0070f3]/30 p-4 rounded text-sm text-[#0070f3] mb-6">
        ✨ Thank you for reaching out! Your message has been sent successfully. We will get back to you shortly.
      </div>

      <form id="contact-form" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex flex-col space-y-2">
            <label for="name" class="text-xs font-semibold text-ink">Your Name</label>
            <input type="text" id="name" required class="bg-canvas border border-hairline text-sm px-4 py-2.5 rounded outline-none text-ink focus:border-hairline-strong transition-colors" placeholder="e.g. Jane Doe">
          </div>
          <div class="flex flex-col space-y-2">
            <label for="email" class="text-xs font-semibold text-ink">Email Address</label>
            <input type="email" id="email" required class="bg-canvas border border-hairline text-sm px-4 py-2.5 rounded outline-none text-ink focus:border-hairline-strong transition-colors" placeholder="e.g. jane@example.com">
          </div>
        </div>

        <div class="flex flex-col space-y-2">
          <label for="message" class="text-xs font-semibold text-ink">Message</label>
          <textarea id="message" rows="6" required class="bg-canvas border border-hairline text-sm px-4 py-2.5 rounded outline-none text-ink focus:border-hairline-strong transition-colors resize-none" placeholder="What's on your mind?"></textarea>
        </div>

        <button type="submit" class="btn-primary w-full md:w-auto text-sm px-6 py-2.5 font-semibold leading-normal shadow-sm">
          Send Message
        </button>
      </form>
    </article>
  </main>

  <!-- Footer Navigation -->
  <footer class="w-full max-w-4xl mx-auto px-6 py-8 border-t border-hairline text-center text-xs text-mute z-10 relative">
    <div class="flex justify-center space-x-6 mb-4">
      <a href="/about" class="hover:text-ink transition-colors">About Us</a>
      <a href="/contact" class="text-ink font-semibold transition-colors">Contact Us</a>
      <a href="/privacy" class="hover:text-ink transition-colors">Privacy Policy</a>
      <a href="/terms" class="hover:text-ink transition-colors">Terms & Conditions</a>
    </div>
    <p>&copy; {new Date().getFullYear()} Zen Aesthetic Clock. All rights reserved.</p>
  </footer>

  <script>
    // Form submission simulation
    const form = document.getElementById('contact-form');
    const successAlert = document.getElementById('contact-success');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Simulate success callback
      successAlert?.classList.remove('hidden');
      (form as HTMLFormElement).reset();
      
      // Scroll to top of form smoothly
      successAlert?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      
      // Hide alert after 8 seconds
      setTimeout(() => {
        successAlert?.classList.add('hidden');
      }, 8000);
    });

    // Randomize background blob starting positions on load
    const blobs = [document.getElementById('blob1'), document.getElementById('blob2'), document.getElementById('blob3')];
    const animationDurations = [25, 30, 35];
    blobs.forEach((blob, index) => {
      if (blob) {
        const duration = animationDurations[index];
        const randomDelay = Math.random() * -duration;
        blob.style.animationDelay = `${randomDelay}s`;
      }
    });
  </script>
</Layout>
